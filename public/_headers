# Cloudflare static-asset headers.
# Files in /_astro/ have a content hash in their name, so a changed file gets a new name:
# browsers can keep them for a year and repeat visitors don't re-download fonts and styles.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# "Add to calendar" files.
/calendar/*
  Content-Type: text/calendar; charset=utf-8

# The app's service worker must always be checked for a newer version.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
