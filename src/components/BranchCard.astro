---
import Icon from "./Icon.astro";
import ServiceTimes from "./ServiceTimes.astro";
import type { Branch } from "../lib/site";

interface Props {
  branch: Branch;
}
const { branch } = Astro.props;
const d = branch.data;
---

<article
  class="card card--link branch-card"
  data-branch-card
  data-lat={d.latitude ?? ""}
  data-lng={d.longitude ?? ""}
>
  <p class="branch-card__distance" data-distance hidden></p>
  <h3>
    <a href={`/branches/${branch.id}/`} class="branch-card__link">{d.town}</a>
  </h3>
  {
    (d.address || d.county) && (
      <p class="card__meta branch-card__where">
        <Icon name="pin" />
        <span>{[d.address, d.county].filter(Boolean).join(", ")}</span>
      </p>
    )
  }
  <ServiceTimes branch={branch} compact />
  <span class="branch-card__more">Branch details <Icon name="arrow" /></span>
</article>

<style>
  .branch-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .branch-card h3 {
    margin: 0;
  }

  .branch-card__link {
    color: var(--navy-800);
    text-decoration: none;
  }

  /* The whole card is clickable via the heading link. */
  .branch-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .branch-card__where {
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
    margin: 0;
  }

  .branch-card__where :global(svg) {
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.25em;
    flex: none;
    color: var(--blue-600);
  }

  .branch-card__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    color: var(--blue-600);
    font-size: 0.95rem;
  }

  .branch-card__more :global(svg) {
    width: 1em;
    height: 1em;
  }

  .branch-card__distance {
    margin: 0;
    align-self: flex-start;
    font-size: 0.8rem;
    font-weight: 700;
    color: #7a5100;
    background: #fdf0d3;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }
</style>
