---
import Icon from "./Icon.astro";
import { liveUrl, settings } from "../lib/site";

// Desktop shows these in the bar (Home is the logo there); the phone menu lists everything in order.
// "Live" waits until there is a stream link to open.
const nav = [
  { href: "/", label: "Home", phoneOnly: true },
  { href: "/about/", label: "About" },
  { href: "/branches/", label: "Branches" },
  { href: "/ministries/", label: "Ministries" },
  { href: "/sermons/", label: "Sermons" },
  { href: "/articles/", label: "Articles" },
  { href: "/events/", label: "Events" },
  { href: "/live/", label: "Live" },
].filter((item) => item.href !== "/live/" || liveUrl());
// Desktop tucks these under "More" so the bar stays on one line; on a phone they are ordinary items.
const more = [
  { href: "/new-here/", label: "New here?" },
  { href: "/visit/", label: "Plan your visit" },
  { href: "/contact/", label: "Contact" },
];

const path = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const moreActive = more.some((item) => isCurrent(item.href));
---

<!--
  The header floats over the top of every page (each page opens with a dark band) and has no
  background there. It slides away while you scroll down and comes back, with a solid
  background, as soon as you scroll up. Back at the top it turns transparent again.
-->
<div class="site-top" data-site-top transition:name="site-top" transition:animate="none">
  {
    settings.announcement && (
      <div class="announce">
        <div class="wrap">
          {settings.announcementLink ? (
            <a href={settings.announcementLink}>{settings.announcement}</a>
          ) : (
            <span>{settings.announcement}</span>
          )}
        </div>
      </div>
    )
  }

  <header class="site-header">
    <div class="wrap site-header__bar">
      <!-- Text only until the official logo is released: add it under "Logo" in Church settings. -->
      <a class="brand" href="/" aria-label={`${settings.siteName} home`}>
        {settings.logo && <img src={settings.logo} alt="" class="brand__logo" width="44" height="44" />}
        <span class="brand__text">
          <span class="brand__name">HOM</span>
          <!-- <span class="brand__sub">Ministries</span> -->
        </span>
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="nav-toggle__open"><Icon name="menu" /></span>
        <span class="nav-toggle__close"><Icon name="close" /></span>
        <span class="visually-hidden">Menu</span>
      </button>

      <nav id="site-nav" class="site-nav" aria-label="Main">
        <ul>
          {
            nav.map((item) => (
              <li class={item.phoneOnly ? "nav-home" : undefined}>
                <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li class="nav-more" data-more>
            <button
              class="nav-more__btn"
              type="button"
              aria-expanded="false"
              aria-controls="nav-more-list"
              data-active={moreActive ? "true" : undefined}
            >
              More <Icon name="chevron" />
            </button>
            <ul id="nav-more-list" class="nav-more__list">
              {
                more.map((item) => (
                  <li>
                    <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
        <a class="btn btn--gold btn--small site-nav__give" href="/give/">Give</a>
      </nav>
    </div>
  </header>
</div>

<script>
  import { animate } from "motion/mini";
  import { onPage } from "../scripts/page";

  // The header is new markup on every page (its active link changes), so it is set up per page.
  onPage((signal) => {
    const top = document.querySelector<HTMLElement>("[data-site-top]");
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const nav = document.getElementById("site-nav");

    if (top && toggle && nav) {
      const root = document.documentElement;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const TOP_ZONE = 8; // within this many px of the top the header is transparent
      const HIDE_AFTER = 90; // don't hide until the visitor is this far down
      const DELTA = 6; // ignore scroll jitter smaller than this

      let lastY = Math.max(0, window.scrollY);
      const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

      function sync() {
        const y = Math.max(0, window.scrollY); // iOS can report negative values while bouncing
        if (y <= TOP_ZONE) {
          top!.classList.remove("is-solid", "is-hidden");
          lastY = y;
          return;
        }
        if (isOpen()) {
          top!.classList.add("is-solid");
          top!.classList.remove("is-hidden");
          lastY = y;
          return;
        }
        const diff = y - lastY;
        if (Math.abs(diff) < DELTA) return;
        if (diff > 0) {
          if (y > HIDE_AFTER) {
            top!.classList.add("is-hidden"); // scrolling down
            setMore(false);
          }
        } else {
          top!.classList.remove("is-hidden"); // scrolling up
          top!.classList.add("is-solid");
        }
        lastY = y;
      }

      function setMenu(open: boolean) {
        toggle!.setAttribute("aria-expanded", String(open));
        nav!.classList.toggle("is-open", open);
        top!.classList.toggle("menu-open", open);
        if (open) {
          top!.classList.remove("is-hidden");
          if (!reduceMotion.matches) {
            animate(
              nav!,
              { opacity: [0, 1], transform: ["translateY(-10px)", "translateY(0px)"] },
              { duration: 0.22, ease: [0.22, 1, 0.36, 1] },
            ).then(() => {
              nav!.style.removeProperty("opacity");
              nav!.style.removeProperty("transform");
            });
          }
        }
        sync();
      }

      // "More" dropdown (desktop only; on a phone its items are part of the flat list).
      const more = document.querySelector<HTMLElement>("[data-more]");
      const moreBtn = more?.querySelector<HTMLButtonElement>(".nav-more__btn");
      const moreOpen = () => more?.classList.contains("is-open") ?? false;
      function setMore(open: boolean) {
        more?.classList.toggle("is-open", open);
        moreBtn?.setAttribute("aria-expanded", String(open));
      }
      moreBtn?.addEventListener("click", () => setMore(!moreOpen()));
      document.addEventListener(
        "click",
        (e) => {
          if (more && !more.contains(e.target as Node)) setMore(false);
        },
        { signal },
      );
      more?.addEventListener("focusout", (e) => {
        if (!more.contains(e.relatedTarget as Node | null)) setMore(false);
      });

      toggle.addEventListener("click", () => setMenu(!isOpen()));
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        if (moreOpen()) {
          setMore(false);
          moreBtn?.focus();
        } else if (isOpen()) {
          setMenu(false);
          toggle.focus();
        }
      }, { signal });
      window.addEventListener(
        "resize",
        () => {
          if (window.innerWidth >= 1024 && isOpen()) setMenu(false);
        },
        { signal },
      );

      // Keyboard users tabbing to the header while it is hidden should see it.
      top.addEventListener("focusin", () => top.classList.remove("is-hidden"));

      // Scroll events already arrive at most once per frame, and sync() only toggles classes.
      window.addEventListener("scroll", sync, { passive: true, signal });
      window.addEventListener("pageshow", sync, { signal });

      // Pages start under the header; keep their top padding equal to its real height.
      const sizer = new ResizeObserver(() => root.style.setProperty("--top-h", `${top.offsetHeight}px`));
      sizer.observe(top);
      signal.addEventListener("abort", () => sizer.disconnect());

      // A page restored part-way down (reload, back button) starts with the solid header.
      if (lastY > TOP_ZONE) top.classList.add("is-solid");
    }
  });
</script>

<style>
  .site-top {
    /* Colours the bar uses while it is transparent over the dark band at the top. */
    --nav-ink: var(--white);
    --nav-hover: var(--white);
    --nav-active: var(--white);
    --nav-bar: var(--gold-500);
    --nav-sub: var(--gold-500);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-top.is-hidden {
    transform: translateY(-100%);
  }

  /* Solid: after scrolling up, and whenever the phone menu is open. */
  .site-top.is-solid,
  .site-top.menu-open {
    --nav-ink: var(--navy-800);
    --nav-hover: var(--blue-600);
    --nav-active: var(--blue-600);
    --nav-bar: var(--blue-600);
    --nav-sub: var(--blue-600);
  }

  .announce {
    background: var(--gold-500);
    color: var(--navy-900);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
    padding: 0.5rem 0;
  }

  .announce a {
    color: inherit;
  }

  .site-header {
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      box-shadow 0.25s;
  }

  .site-top.is-solid .site-header,
  .site-top.menu-open .site-header {
    background: rgb(255 255 255 / 96%);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border-bottom-color: var(--line);
    box-shadow: 0 6px 18px rgb(11 37 69 / 8%);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--nav-ink);
    transition: color 0.25s;
  }

  .brand__logo {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .brand__text {
    display: grid;
    line-height: 1.05;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }

  .brand__sub {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--nav-sub);
    transition: color 0.25s;
  }

  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: var(--radius-sm);
    background: rgb(255 255 255 / 14%);
    background: color-mix(in srgb, var(--nav-ink) 12%, transparent);
    color: var(--nav-ink);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .nav-toggle__close,
  .nav-toggle[aria-expanded="true"] .nav-toggle__open {
    display: none;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__close {
    display: inline;
  }

  .nav-toggle :global(svg) {
    display: block;
  }

  /* Phone: a white panel under the bar, so its colours are fixed rather than following the bar. */
  .site-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
    padding: 0.5rem var(--gutter) 1.25rem;
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
  }

  .site-nav li a {
    display: block;
    padding: 0.8rem 0.25rem;
    border-bottom: 1px solid var(--sky-100);
    color: var(--navy-800);
    font-weight: 600;
    text-decoration: none;
  }

  /* Current page: a bar on the left edge in the phone menu. */
  .site-nav li a[aria-current="page"] {
    color: var(--blue-600);
    padding-left: 0.9rem;
    box-shadow: inset 4px 0 0 var(--blue-600);
  }

  /* "More" is just a flat part of the list on a phone. */
  .nav-more__btn {
    display: none;
  }

  /* (Selectors include .site-nav so they beat the general ".site-nav ul" rules.) */
  .site-nav .nav-more__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__give {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .nav-toggle {
      display: none;
    }

    .site-nav,
    .site-nav.is-open {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      position: static;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: transparent;
    }

    .site-nav ul {
      display: flex;
      gap: 0.1rem;
      margin: 0;
    }

    .site-nav li a {
      position: relative;
      border: 0;
      padding: 0.5rem 0.6rem;
      border-radius: var(--radius-sm);
      font-size: 0.97rem;
      color: var(--nav-ink);
      transition: color 0.25s;
    }

    /* The bar sits under the text. Hover previews it faintly; the current page keeps it solid. */
    .site-nav li a::after {
      content: "";
      position: absolute;
      left: 0.6rem;
      right: 0.6rem;
      bottom: 0;
      height: 3px;
      border-radius: 3px;
      background: var(--nav-bar);
      opacity: 0;
      transform: scaleX(0.4);
      transition:
        opacity 0.15s,
        transform 0.15s,
        background-color 0.25s;
    }

    .site-nav li a:hover {
      color: var(--nav-hover);
    }

    .site-nav li a:hover::after {
      opacity: 0.45;
      transform: scaleX(1);
    }

    .site-nav li a[aria-current="page"] {
      color: var(--nav-active);
      padding-left: 0.6rem;
      box-shadow: none;
    }

    .site-nav li a[aria-current="page"]::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .site-nav__give {
      width: auto;
    }

    /* Home is the logo on desktop. */
    .nav-home {
      display: none;
    }

    /* "More": a button styled like the links, opening a small white panel. */
    .nav-more {
      position: relative;
    }

    .nav-more__btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.5rem 0.6rem;
      border: 0;
      border-radius: var(--radius-sm);
      background: none;
      font: inherit;
      font-size: 0.97rem;
      font-weight: 600;
      color: var(--nav-ink);
      cursor: pointer;
      transition: color 0.25s;
    }

    .nav-more__btn :global(svg) {
      width: 1em;
      height: 1em;
      transition: transform 0.2s;
    }

    .nav-more__btn[aria-expanded="true"] :global(svg) {
      transform: rotate(180deg);
    }

    .nav-more__btn::after {
      content: "";
      position: absolute;
      left: 0.6rem;
      right: 0.6rem;
      bottom: 0;
      height: 3px;
      border-radius: 3px;
      background: var(--nav-bar);
      opacity: 0;
      transform: scaleX(0.4);
      transition:
        opacity 0.15s,
        transform 0.15s,
        background-color 0.25s;
    }

    .nav-more__btn:hover,
    .nav-more__btn[aria-expanded="true"] {
      color: var(--nav-hover);
    }

    .nav-more__btn:hover::after,
    .nav-more__btn[aria-expanded="true"]::after {
      opacity: 0.45;
      transform: scaleX(1);
    }

    .nav-more__btn[data-active="true"] {
      color: var(--nav-active);
    }

    .nav-more__btn[data-active="true"]::after {
      opacity: 1;
      transform: scaleX(1);
    }

    .site-nav .nav-more__list {
      display: none;
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      min-width: 12rem;
      padding: 0.4rem;
      background: var(--white);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .site-nav .nav-more.is-open .nav-more__list {
      display: block;
    }

    /* Inside the panel the background is always white, whatever state the bar is in. */
    .site-nav .nav-more__list li a {
      display: block;
      padding: 0.6rem 0.8rem;
      color: var(--navy-800);
      white-space: nowrap;
    }

    .site-nav .nav-more__list li a::after {
      display: none;
    }

    .site-nav .nav-more__list li a:hover {
      color: var(--blue-600);
      background: var(--sky-100);
    }

    .site-nav .nav-more__list li a[aria-current="page"] {
      color: var(--blue-600);
      padding-left: 0.8rem;
      box-shadow: inset 3px 0 0 var(--blue-600);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-top,
    .site-header,
    .brand,
    .brand__sub,
    .nav-toggle,
    .nav-more__btn,
    .nav-more__btn::after,
    .nav-more__btn :global(svg),
    .site-nav li a,
    .site-nav li a::after {
      transition: none;
    }
  }
</style>
