---
// Shown by the app (service worker) when a page isn't saved and there's no connection.
// Everything someone needs on a Sunday with no signal is on this page itself.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import { formatTime, getBranches, servicesSummary, settings, sharedServices } from "../lib/site";

const branches = await getBranches();
const shared = sharedServices(branches);
const account = settings.centralAccounts[0];
---

<Base title="You're offline" description="Saved information for when there's no connection.">
  <PageHead eyebrow="No connection" title="You're offline" intro="This page isn't saved on your phone yet. Here is what you need until the signal comes back." />
  <section class="section">
    <div class="wrap offline">
      <div class="card">
        <h2><Icon name="clock" /> Service times</h2>
        {
          shared.length > 0 ? (
            <p>Every branch meets {servicesSummary(shared)}.</p>
          ) : (
            <ul>
              {branches.map((b) => (
                <li>
                  <strong>{b.data.town}:</strong> {b.data.services.map((s) => `${s.day} ${formatTime(s.time)}`).join(", ") || "coming soon"}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        settings.centralPaybill && (
          <div class="card">
            <h2>Give by M-Pesa</h2>
            <p>
              Paybill <strong>{settings.centralPaybill}</strong>
              {account && <>, account <strong>{account.account}</strong> ({account.label})</>}
            </p>
          </div>
        )
      }
      <div class="card">
        <h2>Saved on this phone</h2>
        <ul class="offline__saved" data-saved>
          <li><a href="/">Home</a></li>
          <li><a href="/branches/">Our branches</a></li>
          <li><a href="/give/">Give</a></li>
        </ul>
        <button class="btn btn--blue" type="button" data-retry>Try again</button>
      </div>
    </div>
  </section>
</Base>

<script>
  import { onPage } from "../scripts/page";

  onPage((signal) => {
    document.querySelector("[data-retry]")?.addEventListener("click", () => location.reload());
    window.addEventListener("online", () => location.reload(), { signal });

    // List every page the app has saved, by its title.
    const list = document.querySelector<HTMLElement>("[data-saved]");
    if (!list || !("caches" in window)) return;
    (async () => {
      const keys = (await caches.keys()).filter((k) => k.startsWith("pages-"));
      const cache = keys.length ? await caches.open(keys[keys.length - 1]) : null;
      if (!cache) return;
      const items: { href: string; title: string }[] = [];
      for (const req of await cache.keys()) {
        const path = new URL(req.url).pathname;
        if (path === "/offline/") continue;
        const html = await (await cache.match(req))!.text();
        const parsed = new DOMParser().parseFromString(html, "text/html").title || path; // decodes &#39; etc.
        const title = path === "/" ? "Home" : parsed.split(" | ")[0];
        items.push({ href: path, title });
      }
      if (!items.length) return;
      items.sort((a, b) => a.href.localeCompare(b.href));
      list.replaceChildren(
        ...items.map(({ href, title }) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = href;
          a.textContent = title;
          li.append(a);
          return li;
        }),
      );
    })();
  });
</script>

<style>
  .offline {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .offline h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
  }

  .offline h2 :global(svg) {
    width: 1.1em;
    height: 1.1em;
    color: var(--blue-600);
  }

  .offline__saved {
    columns: 2 12rem;
    margin: 0 0 1rem;
    padding-left: 1.1rem;
  }
</style>
