---
import "@fontsource-variable/outfit";
import "@fontsource-variable/montserrat";
import "@fontsource-variable/montserrat/wght-italic.css";
import "../styles/global.css";
// The two fonts used above the fold are preloaded so the headline doesn't flash a fallback font.
import outfitFont from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import montserratFont from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import AudioDock from "../components/AudioDock.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import { settings, whatsappLink } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = `${settings.siteName} — ${settings.tagline}`, image } = Astro.props;
const fullTitle = title ? `${title} | ${settings.siteName}` : settings.siteName;
// Absolute URLs need SITE_URL (see astro.config.mjs); without it these tags are left out.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
const wa = whatsappLink(settings.whatsapp, "Hello Hope Outreach Ministries, ");
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- No tab icon until the official logo is released (set "Logo" in Church settings). -->
    <link rel="icon" href={settings.logo || "data:,"} />
    <link rel="preload" as="font" type="font/woff2" href={outfitFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={montserratFont} crossorigin />
    <meta name="theme-color" content="#0b2545" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Hope Outreach" />
    <!--
      Pages change without a full reload: a short cross-fade (none for reduced motion), and the
      sermon player below keeps playing. Scripts set pages up with onPage() (src/scripts/page.ts).
    -->
    <ClientRouter />
    <!--
      Animations hide content until they run, so they only switch on when scripts work and the
      visitor hasn't asked for reduced motion. If the animation script hasn't started within
      2.5 s (slow data, blocked script), everything is shown as normal.
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        root.classList.add("motion-ok");
        setTimeout(function () {
          if (!window.__motionReady) root.classList.remove("motion-ok");
        }, 2500);
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {
      wa && (
        <a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
          <Icon name="whatsapp" />
        </a>
      )
    }
    <div class="install-banner" data-install-banner hidden>
      <p><strong>Get the app.</strong> Service times, directions and giving, even with no signal.</p>
      <div class="install-banner__actions">
        <button class="btn btn--gold btn--small" type="button" data-install>Install</button>
        <button class="install-banner__close" type="button" data-install-dismiss aria-label="Not now">Not now</button>
      </div>
    </div>
    <AudioDock />
    <script>
      import "../scripts/motion";
      import "../scripts/app";
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .install-banner {
    position: fixed;
    z-index: 55;
    left: 50%;
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    width: min(calc(100% - 1.5rem), 34rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    padding: 0.85rem 1rem;
    border-radius: 16px;
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 16px 40px rgb(5 16 38 / 25%);
  }

  .install-banner p {
    margin: 0;
    flex: 1 1 14rem;
    font-size: 0.95rem;
  }

  .install-banner__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .install-banner__close {
    border: 0;
    background: none;
    padding: 0.6rem;
    font: inherit;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }

  /* Above the sermon player when both are showing. */
  :global(body:has([data-dock]:not([hidden]))) .install-banner {
    bottom: 7.5rem;
  }

  /* Room for the sermon player so it never covers the footer or the WhatsApp button. */
  :global(body:has([data-dock]:not([hidden]))) {
    padding-bottom: 7rem;
  }

  :global(body:has([data-dock]:not([hidden])) .wa-float) {
    bottom: 7.5rem;
  }
</style>
